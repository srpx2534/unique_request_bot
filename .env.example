# --- Veritabanı (yerelde Docker, üretimde yönetilen MySQL) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=unique_request_bot
MYSQL_USER=request
MYSQL_PASSWORD=degistir
MYSQL_ROOT_PASSWORD=degistir_root

# --- Redis kuyruk ve oturum deposu ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Panel ---
PANEL_PORT=8080
SESSION_SECRET=degistir_uzun_rastgele

# --- Worker kimlik doğrulama ---
WORKER_TOKEN=degistir_uzun_rastgele
WORKER_ADRESLER=http://127.0.0.1:8081

# --- Proxy sağlayıcıları ---
DECODO_USER=
DECODO_PASS=
DECODO_GATEWAY=tr.decodo.com:10001
IPROYAL_USER=
IPROYAL_PASS=
IPROYAL_GATEWAY=geo.iproyal.com:12321

# --- SERP ölçüm sağlayıcıları ---
DECODO_SERP_KEY=
SERPER_KEY=
SEARCHAPI_KEY=

# --- Ölçüm aralığı: geliştirmede 120, üretimde 30 (dakika) ---
MEASURE_INTERVAL_MIN=120