"""Burst yÃ¼rÃ¼tÃ¼cÃ¼: izlenim, tÄ±klama, dwell, pogo.

Bir burst, aynÄ± kelime iÃ§in art arda atÄ±lan hit'lerden oluÅŸur. Her hit'te
sÄ±ra ÅŸudur: SERP izlenimi (proxy Ã¼zerinden, doÄŸrudan Google), hedefe
tÄ±klama, dwell, pogo.

Ä°zlenim neden proxy Ã¼zerinden: Google aramayÄ± ve tÄ±klamayÄ± aynÄ± IP'den
gÃ¶rmeli. SERP API'si kendi IP'sini kullanÄ±r, bu yÃ¼zden yalnÄ±zca hedef
adresi Ã§Ã¶zmek iÃ§in bir kez Ã§aÄŸrÄ±lÄ±r; sÄ±ralama bir burst iÃ§inde deÄŸiÅŸmez.

Her hit tek oturum ve tek profil kullanÄ±r; oturum Ã¼Ã§ adÄ±m boyunca aÃ§Ä±k
kalÄ±r, bÃ¶ylece cookie sÃ¼rekliliÄŸi korunur.

SaÄŸlayÄ±cÄ± dÃ¼ÅŸerse hit bir kez, yeni saÄŸlayÄ±cÄ± ve yeni profille tekrarlanÄ±r
(C6). Mobil IP yalnÄ±zca ilk saniyelerde kullanÄ±lÄ±r (Â§8).

KullanÄ±m: worker/app.py, tools/burst_dene.py.
"""

from __future__ import annotations

import random
import time
from typing import Callable
from urllib.parse import quote

from curl_cffi import requests

from worker import cookie, fingerprint, havuz, saglik_db, serp
from worker.burst_hit import sayaclar, tek_hit

AZAMI_HIT = 60  # sÃ¶zleÅŸme Â§9: basamak boyu en fazla 60
HIT_ARASI_MIN = 0.4  # saniye; art arda istekte insan ritmi
HIT_ARASI_MAX = 1.4  # saniye; jitter iÃ§in Ã¼st sÄ±nÄ±r
MOBIL_PENCERE_SN = 8  # saniye; mobil IP yalnÄ±zca bu pencerede kullanÄ±lÄ±r (Â§8)
BASARI_ESIGI = 0.95  # C10; altÄ±nda kalÄ±rsa burst_hata uyarÄ±sÄ± dÃ¼ÅŸer
DENEME = 2  # saÄŸlayÄ±cÄ± dÃ¼ÅŸerse toplam kaÃ§ kez denenir


def burst_yap(
    sorgu: str,
    hedef_domain: str,
    adet: int,
    proxy_secici: Callable[[], str | None] | None = None,
    uule: str | None = None,
    hedef_url: str | None = None,
    geo_slug: str | None = None,
    devam: Callable[[], bool] | None = None,
) -> dict:
    """Burst'Ã¼ yÃ¼rÃ¼tÃ¼r.

    Args:
        sorgu: Aranacak kelime.
        hedef_domain: TÄ±klanacak alan adÄ±.
        adet: AtÄ±lacak hit sayÄ±sÄ±. AZAMI_HIT ile sÄ±nÄ±rlanÄ±r.
        proxy_secici: Her hit iÃ§in proxy dÃ¶ndÃ¼ren Ã§aÄŸrÄ±labilir. None ise
            havuzdan seÃ§ilir.
        uule: Konum parametresi; izlenim adresine eklenir.
        hedef_url: HazÄ±r hedef adres. Verilirse API ile Ã§Ã¶zÃ¼m atlanÄ±r.
        geo_slug: Ä°l slug'Ä±; verilirse il hedefli saÄŸlayÄ±cÄ± aranÄ±r.
        devam: Her hit Ã¶ncesi sorulan 'sÃ¼rsÃ¼n mÃ¼' geri Ã§aÄŸrÄ±sÄ±. False
            dÃ¶nerse kalan hit atÄ±lmaz (C21).

    Returns:
        result, sayaÃ§lar, elapsed_ms, hedef_url, durduruldu ve hits
        alanlarÄ±nÄ± taÅŸÄ±yan sÃ¶zlÃ¼k. result: ok, hedef_yok, anahtar_yok.
    """
    adet = max(1, min(adet, AZAMI_HIT))
    basladi = time.perf_counter()

    sonuc = {"result": "ok", "hedef_url": None, "elapsed_ms": 0,
             "durduruldu": False, "hits": [], **sayaclar()}

    if hedef_url:
        # Adres dÄ±ÅŸarÄ±dan geldiyse API'ye hiÃ§ gidilmez; burst daha hÄ±zlÄ± baÅŸlar.
        serp_url = f"https://www.google.com/search?q={quote(sorgu)}"
    else:
        # Hedef adres bir kez Ã§Ã¶zÃ¼lÃ¼r: 100 hit iÃ§in 1000 API isteÄŸi gitmesin.
        cozum = serp.serp_getir(sorgu, hedef_domain=hedef_domain, uule=uule)
        if cozum["result"] == "anahtar_yok":
            sonuc["result"] = "anahtar_yok"
            return sonuc
        if cozum["result"] != "ok" or not cozum["position"]:
            sonuc["result"] = "hedef_yok"
            sonuc["not_found"] = adet
            # Hedef ilk 100'de yok: panelde gÃ¶rÃ¼lsÃ¼n, sessizce geÃ§mesin.
            saglik_db.uyari("hedef_yok", None, f"'{sorgu}' ilk 100'de bulunamadÄ±", kelime=sorgu, domain=hedef_domain)
            return sonuc
        hedef_url = next(
            k["link"] for k in cozum["organik"] if k["position"] == cozum["position"]
        )
        serp_url = cozum["url"] or f"https://www.google.com/search?q={quote(sorgu)}"

    sonuc["hedef_url"] = hedef_url

    onceki_profil: str | None = None
    durduruldu = False
    failover_uyarildi = False
    # Ä°l kodu bir kez Ã§Ã¶zÃ¼lÃ¼r; her hit'te sorgu aÃ§mamak iÃ§in.
    geo_kodu = havuz.kod_bul(geo_slug) if geo_slug else None
    # Kelime mobil isaretliyse mobil IP ve android profil zorlanir.
    mobil_hedef = havuz.kelime_mobil(sorgu)
    # Mobil pencere hit sayisina cevrilir: duvar saatiyle olculunce ilk hit
    # tek basina pencereyi asiyor ve mobil IP bir daha kullanilmiyordu.
    mobil_hit_siniri = max(1, min(3, round(MOBIL_PENCERE_SN / 4)))
    for sira in range(1, adet + 1):
        # Durdurma her hit Ã¶ncesi sorulur: uÃ§an istek kesilmez, yenisi baÅŸlamaz.
        if devam is not None and not devam():
            durduruldu = True
            break

        # Mobil IP pahalÄ± ve Ã§abuk tÃ¼keniyor; yalnÄ±zca ilk saniyelerde
        # kullanÄ±lÄ±r, sonra residential'a dÃ¼ÅŸÃ¼lÃ¼r (Â§8).
        mobil_acik = sira <= mobil_hit_siniri

        kayit: dict = {}
        failover_oldu = False
        saglayici_id: int | None = None
        for deneme in range(1, DENEME + 1):
            geo_mod: str | None = None
            tur: str | None = None
            if proxy_secici:
                proxy_adres = proxy_secici()
            else:
                # sec_mod ucuncu eleman olarak hangi yoldan gidildigini verir.
                # Paylasilan son_mod globali eszamanli burst'te karisirdi.
                secim = havuz.sec_mod(geo_slug, mobil_acik, "mobile" if mobil_hedef else None)
                proxy_adres = secim[1] if secim else None
                saglayici_id = secim[0] if secim else None
                geo_mod = secim[2] if secim else None
                tur = secim[3] if secim else None

            # Cerez yalnizca ayni ulke IP'siyle anlamli: yabanci hitte yuklenmez.
            cerez_profil: int | None = None
            cerezler: list[dict] = []
            aile: str | None = None
            if geo_mod in ("city", "tr_fallback"):
                secilen = havuz.cerez_sec(geo_kodu, hedef_domain, sorgu, mobil_hedef, ulke="TR")
                if secilen is not None:
                    cerez_profil, aile = secilen
                    cerezler = cookie.suz(havuz.cerez_al(cerez_profil), hedef_domain)

            # Cerez varsa parmak izi o cerezin ailesine sabit; yoksa rastgele.
            mobil_profil = bool(mobil_hedef or (mobil_acik and tur == "mobile"))
            profil = fingerprint.profil_sec(haric=onceki_profil, aile=aile, mobil=mobil_profil)
            onceki_profil = profil
            kayit = tek_hit(sorgu, hedef_url, serp_url, proxy_adres, profil, uule, cerezler)
            # Telemetri secimle birlikte tamamlanir; hit tablosu bunlari bekler.
            kayit["saglayici_id"] = saglayici_id
            kayit["geo_mode"] = geo_mod
            kayit["cerez"] = bool(cerezler)
            if cerez_profil is not None:
                havuz.cerez_birak(cerez_profil)
            if kayit["result"] == "ok" or kayit["result"] == "captcha":
                break
            # SaÄŸlayÄ±cÄ± kaynaklÄ± dÃ¼ÅŸÃ¼ÅŸte yeni saÄŸlayÄ±cÄ±yla bir kez daha
            # denenir; aynÄ± saÄŸlayÄ±cÄ±da Ä±srar etmek zaman kaybÄ±dÄ±r (C6).
            if deneme < DENEME:
                failover_oldu = True
                # Burst baÅŸÄ±na tek uyarÄ± yeter; her hit'te tekrar yazÄ±lmasÄ±n.
                if not failover_uyarildi:
                    saglik_db.uyari("failover", saglayici_id, f"'{sorgu}' saÄŸlayÄ±cÄ± deÄŸiÅŸimi", kelime=sorgu, domain=hedef_domain)
                    failover_uyarildi = True

        # Bayrak deneme dÃ¶ngÃ¼sÃ¼nde kaybolmasÄ±n diye burada iÅŸaretlenir.
        if failover_oldu:
            kayit["failover"] = True

        # SaÄŸlayÄ±cÄ± saÄŸlÄ±ÄŸÄ± yalnÄ±zca gerÃ§ek bir saÄŸlayÄ±cÄ± kullanÄ±ldÄ±ysa iÅŸlenir.
        if saglayici_id:
            # Il cifti yalnizca gercekten il hedefli cikista islenir; ulusal ya
            # da yabanci cikis kodu il ciftine yazarsa esik yanlis ciftte dolar.
            saglik_db.kaydet(
                saglayici_id,
                geo_kodu if kayit.get("geo_mode") == "city" else None,
                kayit["result"],
            )
            saglik_db.bayt_ekle(saglayici_id, kayit["bytes"])
            saglik_db.karantina_kontrol(saglayici_id)

        kayit["sira"] = sira
        sonuc["hits"].append(kayit)
        sonuc[kayit["result"]] = sonuc.get(kayit["result"], 0) + 1

        # Hit arasÄ± bekleme; son hit'ten sonra beklemek gereksiz.
        if sira < adet:
            time.sleep(random.uniform(HIT_ARASI_MIN, HIT_ARASI_MAX))

    sonuc["elapsed_ms"] = int((time.perf_counter() - basladi) * 1000)
    sonuc["durduruldu"] = durduruldu

    # KapanÄ±ÅŸ deÄŸerlendirmesi: oran eÅŸiÄŸin altÄ±ndaysa uyarÄ± dÃ¼ÅŸÃ¼lÃ¼r.
    if sonuc["ok"] / adet < BASARI_ESIGI:
        saglik_db.uyari(
            "burst_hata", None,
            f"'{sorgu}' tamamlanma %{round(sonuc['ok'] * 100 / adet)} "
                        f"(ok={sonuc['ok']} captcha={sonuc['captcha']} hata={sonuc['error']})",
            kelime=sorgu, domain=hedef_domain,
        )
    if sonuc["captcha"]:
        saglik_db.uyari("captcha", None, f"'{sorgu}' captcha={sonuc['captcha']}", kelime=sorgu, domain=hedef_domain)
    return sonuc