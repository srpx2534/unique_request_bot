# Bu dosyayi .env olarak kullan. Yalnizca onyukleme sirlari burada durur.
# SERP anahtarlari, oranlar ve olcum araligi panelden yonetilir.
# Proxy kimlik bilgileri .env'de degil, Saglayicilar ekraninda tutulur.

# --- Veritabani ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=unique_request_bot
MYSQL_USER=request
MYSQL_PASSWORD=
# Yedek ve geri yukleme root ile kosar (dump gorunumleri DEFINER=root tasir).
MYSQL_ROOT_PASSWORD=

# --- Redis: kuyruk ve oturum deposu ---
# Parola zorunlu; compose redis'i --requirepass ile acar, deger sunucudaki ile ayni olmali. URL'e gomulmez.
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379/0

# --- Sirlar: en az 32 karakter, rastgele. Uretimi: openssl rand -hex 32 ---
SESSION_SECRET=
WORKER_TOKEN=

# --- Istege bagli: bos birakilirsa kod varsayilani kullanir ---
# PANEL_PORT=8080
# PANEL_ADRES=http://127.0.0.1:8080
# WORKER_PORT=8081
# DUGUM_ID=127.0.0.1
# TLS sonlandiran ters proxy kac adim ondeyse (17.3).
# TRUST_PROXY=1

# Yukleme gecici klasoru; konteynerde kalici birime baglanmali.
# Konteynerde kalici birime baglanir; bos birakilirsa kod varsayilanini kullanir.
CEREZ_YUKLEME_KOK=
